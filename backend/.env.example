PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=30d

# For Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/hospital_vision_hms

